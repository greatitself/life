{
  "name": "life-desktop",
  "version": "0.4.0",
  "description": "A customizable research workspace for Codex and Claude Code over SSH",
  "main": "out/main/index.js",
  "private": true,
  "author": "Life",
  "repository": {
    "type": "git",
    "url": "https://github.com/greatitself/life.git"
  },
  "homepage": "https://github.com/greatitself/life#readme",
  "bugs": {
    "url": "https://github.com/greatitself/life/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 0.0.0.0",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:desktop": "node tests/desktop-smoke.cjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "esbuild": "0.25.12",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.1.0",
    "npm": "11.6.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ssh2": "^1.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "playwright": "^1.55.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "dev.life.desktop",
    "productName": "Life",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/cpu-features/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "src/renderer/assets/svgl/LICENSE",
        "to": "licenses/svgl-LICENSE.txt"
      },
      {
        "from": "src",
        "to": "life-source/src"
      },
      {
        "from": "out/source/package.json",
        "to": "life-source/package.json"
      },
      {
        "from": "out/source/runtime-smoke.cjs",
        "to": "life-source-runtime.cjs"
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Development",
      "maintainer": "greatitself",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "greatitself",
      "repo": "life",
      "releaseType": "release"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "asarUnpack": [
      "node_modules/**/*"
    ]
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
